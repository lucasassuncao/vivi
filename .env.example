# Copy to .env. Points at the throwaway Vault from `make vault-up`: dev mode,
# in memory, root token. Never point this at a real Vault.
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=root

# Everything below is optional and commented out. vivi reads the environment,
# never this file, so exporting these or prefixing a command works the same.

# Drop VAULT_TOKEN entirely and vivi falls back to ~/.vault-token, the file
# `vault login` writes.

# Enterprise namespace every request is scoped to.
#VAULT_NAMESPACE=admin

# Colour theme, same as --theme. `vivi --list-themes` prints all 56; unset is
# the adaptive palette, the only one that reads on light and dark alike.
#VIVI_THEME=mango

# Refuse every write, same as --read-only. "prod" refuses only when the server
# is not a recognised sandbox, "on" always, "off" never.
#VIVI_READ_ONLY=prod

# A file to record keystrokes into. A TUI has no stdout to print to, so this is
# the only way to see what the terminal actually sent.
#VIVI_DEBUG=/tmp/vivi-keys.log

# Read by the Vault SDK, not by vivi: a real server behind TLS or a proxy.
# VAULT_SKIP_VERIFY=true disables certificate checking, so leave it alone
# unless you are pointing at a self-signed sandbox you own.
#VAULT_CACERT=/etc/ssl/certs/vault-ca.pem
#VAULT_CAPATH=/etc/ssl/certs
#VAULT_CLIENT_CERT=/etc/ssl/certs/vault-client.pem
#VAULT_CLIENT_KEY=/etc/ssl/private/vault-client-key.pem
#VAULT_TLS_SERVER_NAME=vault.internal
#VAULT_SKIP_VERIFY=false
#VAULT_CLIENT_TIMEOUT=60s
#VAULT_MAX_RETRIES=2
#VAULT_HTTP_PROXY=http://proxy.internal:3128

# Only for working on vivi itself. The integration suite refuses any VAULT_ADDR
# that is not loopback whatever this says, because it creates and deletes paths.
#VIVI_INTEGRATION=1
#VAULT_FORWARD_PORT=8200
#VAULT_FORWARD_TARGET=host.docker.internal
