{
  "name": "Vivi",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceFolder": "/workspaces/vivi",
  "shutdownAction": "stopContainer",
  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "postStartCommand": "bash .devcontainer/vault-forward.sh",
  "postAttachCommand": "bash",

  // Vault, so the host can reach it too.
  "forwardPorts": [
    8200
  ],
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "capAdd": [
    "SYS_PTRACE"
  ],

  // Defines host.docker.internal on a plain Linux daemon; vault-forward.sh
  // only uses it as a fallback behind the default gateway.
  "runArgs": [
    "--add-host=host.docker.internal:host-gateway"
  ],

  "mounts": [
    "source=vivi-go-mod-cache,target=/go/pkg/mod,type=volume",
    "source=vivi-go-build-cache,target=/home/vscode/.cache/go-build,type=volume"
  ],

  // The dev-mode Vault from scripts/dev/docker-compose.yml. Loopback and not
  // host.docker.internal: the integration suite refuses a non-local address,
  // and vault-forward.sh is what makes 127.0.0.1 mean the host's Vault.
  "remoteEnv": {
    "VAULT_ADDR": "http://127.0.0.1:8200",
    "VAULT_TOKEN": "root"
  },

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": "false",
      "upgradePackages": "true",
      "userGid": "automatic",
      "userUid": "automatic",
      "username": "automatic"
    },
    "ghcr.io/devcontainers/features/git:1.3.7": {
      "ppa": "false",
      "version": "os-provided"
    },
    "ghcr.io/devcontainers/features/go:1": {
      "golangciLintVersion": "latest",
      "version": "1.27.0"
    },
    // CLI and compose in here, daemon on the host, so the Vault stack is a
    // sibling container. Brings its own docker.sock mount and proxy.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": "false",
      "dockerDashComposeVersion": "v2",
      "installDockerBuildx": "true"
    },
    "ghcr.io/devcontainers/features/powershell:2.0.2": {
      "version": "latest"
    },
    "ghcr.io/eitsupi/devcontainer-features/jq-likes:2.1.1": {
      "jqVersion": "latest",
      "yqVersion": "latest"
    }
  },

  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "files.insertFinalNewline": true,
        "go.delveConfig": {
          "apiVersion": 2,
          "dlvLoadConfig": {
            "followPointers": true,
            "maxArrayValues": 64,
            "maxStringLen": 512,
            "maxStructFields": -1,
            "maxVariableRecurse": 1
          }
        },
        "go.inlayHints.assignVariableTypes": true,
        "go.inlayHints.compositeLiteralFields": true,
        "go.inlayHints.compositeLiteralTypes": true,
        "go.inlayHints.constantValues": true,
        "go.inlayHints.functionTypeParameters": true,
        "go.inlayHints.parameterNames": true,
        "go.inlayHints.rangeVariableTypes": true,
        "go.lintOnSave": "file",
        "go.lintTool": "golangci-lint",
        "go.testFlags": [
          "-v",
          "-race"
        ],
        "go.toolsManagement.autoUpdate": true,
        "go.toolsManagement.checkForUpdates": "off",
        "go.useLanguageServer": true,
        "gopls": {
          "ui.diagnostic.staticcheck": true
        },
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.tabs.title": "${workspaceFolderName}"
      },
      "extensions": [
        "Anthropic.claude-code",
        "golang.go",
        "redhat.vscode-yaml",
        "EditorConfig.EditorConfig",
        "github.vscode-github-actions",
        "ms-azuretools.vscode-docker",
        "kamikillerto.vscode-colorize",
        "DavidAnson.vscode-markdownlint",
        "ms-vscode.makefile-tools"
      ]
    }
  }
}
